# MCORE-1 — copy to `.env` for local MCP / Appwrite (never commit secrets)

# --- uv (optional) ---
# UV_PYTHON=3.12

# --- Appwrite (server / MCP delegation) ---
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_FUNCTION_CHECK_TREE_ID=
APPWRITE_USE_FUNCTIONS=false

# Used by scripts/deploy_appwrite_function.sh (function $id in your project)
APPWRITE_FUNCTION_ID=mcore_check_tree

# --- PostHog (optional — MCP + Function telemetry) ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- MCP ---
# MCORE_MCP_DISTINCT_ID=dev-user-1
