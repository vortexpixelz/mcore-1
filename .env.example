# MCORE-1 + Appwrite + MCP (local defaults)

# --- Core library (optional cloud / AI extras) ---
# pip install -e ".[mcp]"

# Appwrite (server / MCP delegation only)
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# When set with APPWRITE_USE_FUNCTIONS, MCP routes check_tree to Functions:
APPWRITE_FUNCTION_CHECK_TREE_ID=
APPWRITE_USE_FUNCTIONS=false

# PostHog (optional — MCP tool analytics + Function telemetry)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# MCP distinct ID (optional — defaults to anonymous per process)
# MCORE_MCP_DISTINCT_ID=dev-user-1
