{
  "projectId": "<PROJECT_ID>",
  "endpoint": "https://<REGION>.cloud.appwrite.io/v1",
  "functions": [
    {
      "$id": "mcore_check_tree",
      "name": "MCORE check_tree (DNA + weights)",
      "enabled": true,
      "live": true,
      "logging": true,
      "runtime": "python-3.12",
      "timeout": 60,
      "entrypoint": "src/main.py",
      "commands": "pip install -r requirements.txt",
      "version": "v3",
      "path": "functions/check_tree"
    }
  ],
  "tablesDB": [
    {
      "$id": "mcore_main",
      "name": "MCORE main database",
      "enabled": true
    }
  ],
  "tables": [
    {
      "$id": "mcore_sessions",
      "databaseId": "mcore_main",
      "name": "MCORE sessions",
      "enabled": true,
      "rowSecurity": true,
      "columns": [
        { "key": "user_id", "type": "varchar", "size": 36, "required": true },
        { "key": "name", "type": "varchar", "size": 255, "required": true },
        { "key": "slug", "type": "varchar", "size": 128, "required": false },
        { "key": "settings", "type": "mediumtext", "required": false }
      ],
      "indexes": [{ "key": "user_created", "type": "key", "columns": ["user_id", "$createdAt"] }]
    }
  ],
  "buckets": [
    {
      "$id": "mcore_artifacts",
      "name": "TME exports and tree diagrams",
      "enabled": true,
      "maximumFileSize": 33554432,
      "allowedFileExtensions": ["json", "png", "svg", "pdf", "txt"],
      "compression": "gzip",
      "encryption": false,
      "antivirus": true
    }
  ],
  "teams": [],
  "topics": []
}
